<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Fixture for a source root that holds a file the assembly is not built from: Program.Legacy.cs, an
       older copy of Program.cs excluded from compilation. Only Program.cs is in the assembly and in its
       PDB; the document describes Program.cs. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Program.*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.3.0" />
  </ItemGroup>

</Project>
