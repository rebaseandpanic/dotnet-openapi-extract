<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Fixture for Swagger configured outside the entry point: Program.cs calls AddApiSwagger(), an
       extension method in SwaggerSetup.cs that registers SwaggerGen with its document, license and
       security definition. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.3.0" />
  </ItemGroup>

</Project>
