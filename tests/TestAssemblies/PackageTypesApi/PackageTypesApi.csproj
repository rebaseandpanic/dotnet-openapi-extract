<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Fixture for the origin of a component's type: the application, a library it references as a
       project, and a NuGet package whose XML documentation the build does not copy (the default). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PackageTypesContracts\PackageTypesContracts.csproj" />
  </ItemGroup>

</Project>
