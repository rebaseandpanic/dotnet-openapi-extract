<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Fixture for the ways a Swashbuckle 10 Program.cs writes its document metadata and security:
       target-typed and fully qualified creations, both requirement syntaxes of Microsoft.OpenApi 2.x,
       and strings built from raw literals, concatenation, constants, nameof and constant
       interpolation. It is compiled, so every form here is code Swashbuckle 10 accepts. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.3.0" />
  </ItemGroup>

</Project>
