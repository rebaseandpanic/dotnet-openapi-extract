<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Fixture for Asp.Versioning configured outside the entry point: Program.cs calls AddVersionedHttpSurface(),
       an extension method in Http/VersionedHttpSurface.cs, which hands the services to ApiVersioningSetup.Add,
       a static method of another class, that registers the API explorer with SubstituteApiVersionInUrl and
       SubstitutionFormat. Uses the real Asp.Versioning package. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591;CS8321</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="8.1.0" />
  </ItemGroup>

</Project>
