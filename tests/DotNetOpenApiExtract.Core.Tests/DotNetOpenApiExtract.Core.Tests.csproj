<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Corvus.Json.Validator compiles schemas with Roslyn at runtime and needs the reference assemblies. -->
    <PreserveCompilationContext>true</PreserveCompilationContext>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="Microsoft.OpenApi.YamlReader" Version="3.10.2" />
    <!-- JSON Schema 2020-12 evaluator: checks that real System.Text.Json output satisfies the generated schemas. -->
    <PackageReference Include="Corvus.Json.Validator" Version="5.7.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- Each integration test class holds 300-400 MB of loaded assemblies and Roslyn
         compilations; with one worker per core the run outgrows a small machine's memory.
         Two workers finish as fast as four. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DotNetOpenApiExtract.Core\DotNetOpenApiExtract.Core.csproj" />
    <!-- Built so that CLI tests can run DotNetOpenApiExtract.Cli.dll as a process; not referenced as an assembly. -->
    <ProjectReference Include="..\..\src\DotNetOpenApiExtract.Cli\DotNetOpenApiExtract.Cli.csproj" ReferenceOutputAssembly="false" />
    <!-- Referenced as an assembly: tests serialize its types with the real System.Text.Json and run its results. -->
    <ProjectReference Include="..\TestAssemblies\ModernApi\ModernApi.csproj" />
  </ItemGroup>

</Project>
